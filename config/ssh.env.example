# Copy to private/ssh.env and use your own device and client key.
THINKSMART_HOST=thinksmart.example.ts.net
THINKSMART_USER=root
THINKSMART_SSH_KEY="$HOME/.ssh/id_ed25519"
# project_dir is set by tools/thinksmart-ssh before reading this file.
THINKSMART_KNOWN_HOSTS="$project_dir/private/known_hosts"
THINKSMART_SSH_PORT=22
# Set THINKSMART_HOST_KEY_ALIAS only when intentionally retaining a verified identity.
