#!/usr/bin/env python3
"""Local JSON tool client. Run as thinksmart or root; no network listener."""
import json
import os
import socket
import sys

try:
    raw = sys.argv[1] if len(sys.argv) == 2 else (sys.stdin.read(32769) if not sys.stdin.isatty() else '{"action":"system.capabilities"}')
    request = json.loads(raw or '{"action":"system.capabilities"}')
    if not isinstance(request, dict):
        raise ValueError('Expected a JSON request object')
    data = json.dumps(request, separators=(',', ':')).encode() + b'\n'
    if len(data) > 32768:
        raise ValueError('Request is too large')
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(40 if request.get("action") in {"iptv.search", "audiobooks.search"} else 20 if request.get("action") == "radio.search" else 20 if request.get("action", "").startswith("music.") else 4)
        client.connect(os.environ.get('THINKSMART_CONTROL_SOCKET', '/run/thinksmart-ui/control.sock'))
        client.sendall(data)
        reply = b''
        while not reply.endswith(b'\n'):
            chunk = client.recv(65536)
            if not chunk:
                break
            reply += chunk
            if len(reply) > 262144:
                raise ValueError('Reply is too large')
    result = json.loads(reply)
    print(json.dumps(result, ensure_ascii=False))
    sys.exit(0 if result.get('ok') else 2)
except (OSError, ValueError) as error:
    print(json.dumps({'ok': False, 'error': str(error)}))
    sys.exit(1)
